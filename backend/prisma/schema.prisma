// Ticket Management — multi-organisation data model.
// Hierarchy: Organization → Project → Ticket. Each org is fully isolated and
// has exactly ONE Super Admin (enforced by a partial unique index in the init
// migration). One user account can belong to many orgs with a role per org.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Role of a user *within* an organisation.
enum OrgRole {
  SUPER_ADMIN
  ADMIN
  DEVELOPER
  CLIENT
}

// Roles an invite can carry. SUPER_ADMIN is deliberately absent — the only SA
// is the org creator (or via ownership transfer), never via invite.
enum InviteRole {
  ADMIN
  DEVELOPER
  CLIENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  BUG
  FEATURE
  TASK
}

enum CommentVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum NotificationType {
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  MENTIONED
}

// Who can open an attachment. INTERNAL = team only, CLIENT_VISIBLE = also the
// project's customers, SELECTED = only the people listed in AttachmentAccess
// (plus the uploader and Admin/Super Admin). Separate from CommentVisibility
// because comments have no "selected members" mode.
enum AttachmentVisibility {
  INTERNAL
  CLIENT_VISIBLE
  SELECTED
}

enum ActivityType {
  TICKET_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TYPE_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  DUE_DATE_CHANGED
  ASSIGNED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  ATTACHMENT_VISIBILITY_CHANGED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  FOLLOWER_ADDED
  FOLLOWER_REMOVED
  MOVED
  ARCHIVED
  RESTORED
  DUPLICATED
}

enum TwoFactorMethod {
  PIN
  PASSKEY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // bcrypt; every account is email/password
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrgMembership[]
  reportedTickets Ticket[]             @relation("Reporter")
  assignedTickets Ticket[]             @relation("Assignee")
  comments        Comment[]
  notifications   Notification[]
  sentInvites     Invite[]             @relation("InvitedBy")
  attachments     Attachment[]
  passwordResets  PasswordResetToken[]
   pinResets       PinResetToken[]
    orgCreationRequests OrgCreationRequest[]
  platformRole         PlatformRole?
  platformAdminActive  Boolean       @default(true)
  passwordHistory PasswordHistory[]
  pinHistory      PinHistory[]
    twoFactorEnabled Boolean          @default(false)
  twoFactorMethod  TwoFactorMethod?
  pinHash          String?
  pinAttempts      Int              @default(0)
  pinLockedUntil   DateTime?
  // Authenticator app (TOTP) — an extra way to verify when the passkey PIN isn't available.
  // The secret is AES-256-GCM encrypted (see lib/authenticator.ts); a pending secret exists only during setup.
  totpSecretEnc        String?
  totpEnabledAt        DateTime?
  totpPendingSecretEnc String?
  totpPendingAt        DateTime?
  totpLastStep         Int?      // last accepted 30s step: a code can't be replayed
  totpAttempts         Int       @default(0)
  totpLockedUntil      DateTime?
  ticketStatusChanges TicketStatusHistory[] @relation("TicketStatusChanges")
  attachmentAccess    AttachmentAccess[]
  ticketActivities    TicketActivity[]      @relation("ActivityActor")
  ticketFollows       TicketFollower[]      @relation("FollowerUser")
  followersAdded      TicketFollower[]      @relation("FollowerAddedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-org Telegram notifications (configured by the Super Admin). When
  // unset, telegram sends fall back to console logs.
  telegramBotToken String?
  telegramChatId   String?

  // IANA timezone that defines "today" for this organisation's due-date views.
  // Existing organisations get Asia/Kolkata; the Super Admin can change it.
  timezone String @default("Asia/Kolkata")

  memberships OrgMembership[]
  projects    Project[]
  invites     Invite[]
}

model OrgMembership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole
  disabled  Boolean  @default(false) // per-org deactivation; account stays valid elsewhere
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectAccess ProjectClient[]
  projectDevAccess ProjectDeveloper[]

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}

model Project {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Set when an Admin / Super Admin archives the project: hidden from the default
  // project lists and read-only until restored (null = live).
  archivedAt  DateTime?

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  clients ProjectClient[]
  developers ProjectDeveloper[]

  @@index([orgId])
}

// Attaches a CLIENT membership to a project. Clients only see projects they
// are attached to; internal roles (SA/ADMIN/DEVELOPER) see all org projects.
model ProjectClient {
  id           String   @id @default(cuid())
  projectId    String
  membershipId String
  createdAt    DateTime @default(now())

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@index([membershipId])
}

// Explicit developer-to-project assignment. A DEVELOPER sees a project if
// EITHER they're attached here OR they have a ticket assigned to them in it
// (see lib/projectAccess.ts) — this table covers the "attached ahead of any
// ticket" case, e.g. right after being invited to a project with no tickets
// yet assigned. Mirrors ProjectClient's shape deliberately.
model ProjectDeveloper {
  id           String   @id @default(cuid())
  projectId    String
  membershipId String
  createdAt    DateTime @default(now())

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@index([membershipId])
}

model Invite {
  id          String       @id @default(cuid())
  email       String
  orgId       String
  role        InviteRole
  // For CLIENT invites: projects to attach on acceptance. Always re-validated
  // against the invite's org when consumed (cross-org leak guard).
  projectIds  String[]     @default([])
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([orgId])
}

// Pending open-signup: org + account are only created after the emailed OTP
// is verified, so unverified junk never lands in User/Organization.
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  orgName      String
  name         String
  passwordHash String
  codeHash     String // sha256 of the 6-digit OTP
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// One-time tokens for the "forgot password" flow. We store only a SHA-256 hash
// of the token; the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time tokens for the "forgot PIN" flow. Only issuable mid-login, right
// after the password step has already succeeded (see POST /auth/2fa/forgot-pin) —
// this is what stops someone without the password from resetting the PIN.
model PinResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PlatformRole {
  SUPER_ADMIN
}

// A pending "create a new organisation" action, gated behind an email
// click-to-confirm step so a hijacked session alone can't spin up an org.
model OrgCreationRequest {
  id            String    @id @default(cuid())
  requestedById String
  orgName       String
  tokenHash     String    @unique
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdOrgId  String?
  createdAt     DateTime  @default(now())

  requestedBy User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById])
}

// Archive of a user's previous password hashes, used to block reuse.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Archive of a user's previous PIN hashes (bcrypt), used to block reuse — same
// design as PasswordHistory. The CURRENT PIN lives on User.pinHash.
model PinHistory {
  id        String   @id @default(cuid())
  userId    String
  pinHash   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Ticket {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String         @default("")
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(TASK)
  assigneeId  String?
  reporterId  String
  dueDate     DateTime?
  estimate    Float? // hours
  // Soft archive: archived tickets are hidden from lists, counts and My Work
  // (customers can't open them at all) but nothing is deleted; Restore clears it.
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("Assignee", fields: [assigneeId], references: [id])
  reporter      User           @relation("Reporter", fields: [reporterId], references: [id])
  comments      Comment[]
  notifications Notification[]
  attachments   Attachment[]
  statusHistory TicketStatusHistory[]
  activity      TicketActivity[]
  followers     TicketFollower[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([archivedAt])
}

// Append-only audit trail of everything important that happens to a ticket.
// There is deliberately NO update/delete API for it, and a database trigger
// (see the ticket_collaboration migration) rejects UPDATE and direct DELETE
// even from raw SQL — rows only disappear when their ticket is deleted
// (FK cascade). `internalOnly` rows are hidden from customers.
model TicketActivity {
  id           String       @id @default(cuid())
  ticketId     String
  actorId      String
  type         ActivityType
  field        String? // e.g. "status", "priority" (for display)
  fromValue    String? // human-readable snapshot (names, not ids)
  toValue      String?
  meta         Json? // extra context: filename, projectIds, commentId...
  internalOnly Boolean      @default(false)
  createdAt    DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketFollower {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  addedById String
  createdAt DateTime @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user    User   @relation("FollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User   @relation("FollowerAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([userId])
}

// Records every status transition a ticket goes through. Written once per
// actual change (see routes/tickets.ts's PATCH handler) — never backfilled
// retroactively, so tickets that were already DONE before this model existed
// have no rows here; callers that need a completion date for those fall back
// to the ticket's `updatedAt` (see lib/myWork.ts).
//
// This is the actual source of truth for "when was this ticket completed" —
// deliberately not `updatedAt`, which changes on ANY edit (title, priority,
// due date, etc.), not just status changes, and would make "completed this
// week" drift to "edited this week" for tickets touched after completion.
model TicketStatusHistory {
  id          String       @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  changedAt   DateTime     @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation("TicketStatusChanges", fields: [changedById], references: [id])

  @@index([ticketId, changedAt])
  @@index([toStatus, changedAt])
}

model Comment {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  parentId   String?
  body       String
  visibility CommentVisibility @default(INTERNAL)
  editedAt   DateTime? // set when the author edits the comment
  createdAt  DateTime          @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  parent      Comment?     @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("Thread")
  attachments Attachment[]

  @@index([ticketId])
}

model Attachment {
  id         String            @id @default(cuid())
  ticketId   String
  commentId  String? // set when the file was attached to a comment
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  storageKey String // relative path on disk (or object key once on S3)
  visibility AttachmentVisibility @default(CLIENT_VISIBLE)
  createdAt  DateTime             @default(now())

  ticket   Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment  Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User               @relation(fields: [uploaderId], references: [id])
  access   AttachmentAccess[]

  @@index([ticketId])
  @@index([commentId])
}

// Who a SELECTED-visibility attachment is shared with.
model AttachmentAccess {
  id           String   @id @default(cuid())
  attachmentId String
  userId       String
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  ticketId  String
  isRead    Boolean          @default(false)
  payload   Json?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
