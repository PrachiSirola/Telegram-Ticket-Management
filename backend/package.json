{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "db:migrate-assignees": "tsx src/scripts/migrate-assignees.ts",
    "db:migrate-from-postgres": "tsx src/scripts/migrate-postgres-to-mongo.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10"
  }
}
