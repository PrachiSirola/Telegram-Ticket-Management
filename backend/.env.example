# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://ticket:ticket@localhost:5433/ticket_mgmt?schema=public"

# Auth / sessions
JWT_SECRET="change-me-in-production"
SESSION_COOKIE_NAME="tm_session"

# Frontend URL (for CORS + links in emails)
FRONTEND_URL="http://localhost:5173"

# Transactional email — signup OTPs + password-reset links.
# Driver precedence: SMTP_URL -> RESEND_API_KEY -> console log.
#
# Local dev: point SMTP_URL at Mailpit (started by docker compose) and every
# email lands in the fake inbox at http://localhost:8025 — any recipient
# address, nothing leaves your machine.
SMTP_URL="smtp://localhost:1025"
# Production: leave SMTP_URL empty and set a Resend key
# (https://resend.com/api-keys). If both are empty, emails are logged to the
# server console instead of being sent.
RESEND_API_KEY=""
# Must be a verified sender/domain in Resend. The default onboarding@resend.dev
# only delivers to your own Resend account email — set your own for production.
EMAIL_FROM="Tickets <onboarding@resend.dev>"

# Telegram notifications are configured PER ORGANISATION by each org's Super
# Admin (Org Settings page) — no env vars needed.

# Attachments (local disk; swap to S3/R2 for production)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB="10"
