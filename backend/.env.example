# Server
PORT=1019
NODE_ENV=development

# Database
DATABASE_URL="postgresql://ticket:ticket@localhost:5433/ticket_mgmt?schema=public"

# Auth / sessions
JWT_SECRET="change-me-in-production"
SESSION_COOKIE_NAME="tm_session"

# Frontend URL (for CORS + links in emails)
FRONTEND_URL="http://localhost:1020"
UPLOAD_DIR="uploads"

# Email (OTPs, invites, password resets).
#   development -> Mailpit over SMTP (default; start it with `npm run db:up`,
#                  read mail at http://localhost:8025)
#   production  -> Brevo HTTP API (default when NODE_ENV=production)
# Optional override: brevo | smtp | both | console (console just prints emails to the server log)
#   both = a copy in Mailpit AND real delivery through Brevo, so mail to real inboxes
#          (e.g. owner@mailinator.com) arrives too. Needs BREVO_API_KEY + a verified SMTP_FROM.
#          Reserved test addresses (.test, .example, .invalid, .localhost) go to Mailpit only.
# EMAIL_PROVIDER=smtp
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Sender shown on every email. Must be a verified sender in Brevo for production.
SMTP_FROM="Ticketmanagement <no-reply@example.com>"
# Production only — set this in your host's dashboard (e.g. Render), never commit a real key:
# BREVO_API_KEY=
MAX_UPLOAD_MB="10"