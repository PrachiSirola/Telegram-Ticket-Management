# Server
PORT=1019
NODE_ENV=development

# Database (MongoDB). Transactions need a replica set - docker-compose.yml starts one as "rs0".
MONGODB_URI="mongodb://127.0.0.1:27017/ticket_mgmt?replicaSet=rs0&directConnection=true"
# Optional: database name when it is not part of the URI
# MONGODB_DB="ticket_mgmt"
# auto (default) = use transactions when the server supports them, on = require them, off = never
# MONGO_TRANSACTIONS="auto"

# Auth / sessions
JWT_SECRET="change-me-in-production"
# Encrypts authenticator-app (2FA) secrets and keys backup-code hashes. Required in production for the
# authenticator feature (generate with: openssl rand -base64 32). Keep it stable once users enrol.
TOTP_ENCRYPTION_KEY="change-me-in-production"
SESSION_COOKIE_NAME="tm_session"

# Frontend URL (for CORS + links in emails)
FRONTEND_URL="http://localhost:1020"
UPLOAD_DIR="uploads"
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Sender shown on every email. Must be a verified sender in Brevo for production.
SMTP_FROM="Ticketmanagement <no-reply@example.com>"
# Production only — set this in your host's dashboard (e.g. Render), never commit a real key:
# BREVO_API_KEY=
MAX_UPLOAD_MB="10"